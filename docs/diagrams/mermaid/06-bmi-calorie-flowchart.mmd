flowchart TD
    A(["User submits the profile form<br/>UserInfo.jsx handleSubmit"]) --> B["BMI = weight / (height / 100)²<br/>calculateBMI(), rounded to 2 decimals"]
    B --> C{"Gender selected?"}
    C -->|Male| D["BMR = 10W + 6.25H - 5A + 5"]
    C -->|Female| E["BMR = 10W + 6.25H - 5A - 161"]
    C -->|Other| F["suggestCalories() returns the text<br/>'Please provide a valid gender'"]
    F --> F2["Backend cannot cast text to Number<br/>POST /userinfo returns 500"]
    D --> G{"Activity level"}
    E --> G
    G -->|Sedentary| G1["x 1.2"]
    G -->|Lightly Active| G2["x 1.375"]
    G -->|Moderately Active| G3["x 1.55"]
    G -->|Very Active| G4["x 1.725"]
    G1 --> H["TDEE = BMR x multiplier"]
    G2 --> H
    G3 --> H
    G4 --> H
    H --> I{"formData.bmi<br/>(value from BEFORE this submit)"}
    I -->|"below 18.5, or empty on first submit"| J["TDEE + 500"]
    I -->|"above 24.9"| K["TDEE - 500"]
    I -->|"18.5 to 24.9"| L["TDEE unchanged"]
    J --> M["Math.round()"]
    K --> M
    L --> M
    M --> N["POST /userinfo<br/>{ ...form, bmi, dailyCalorieRequirement, userId }"]
    N --> O[("userinfos collection<br/>upsert by userId")]
    O --> P["Profile.jsx: calorie goal (default 2000)<br/>reportController.js: % of daily requirement"]

    classDef bug fill:#fdecea,stroke:#c0392b,color:#5a1a12
    classDef calc fill:#f4f9f1,stroke:#4f7f3a,color:#1e2b18
    class F,F2,I bug
    class B,D,E,H,M calc
